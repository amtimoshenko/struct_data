if __name__ == "__main__":
    # Тестируем TypedList[int]
    print("=== Тестирование TypedList[int] ===")
    int_list = TypedList[int]()
    for num in [10, 20, 30, 40, 50]:
        int_list.add(num)
    print(f"Исходный список: {int_list}")

    filtered = int_list.filter(lambda x: x > 25)
    print(f"После filter(x > 25): {filtered}")

    mapped = int_list.map(lambda x: x * 2)
    print(f"После map(x * 2): {mapped}")

    grouped = int_list.group_by(lambda x: x % 2 == 0)
    print(f"После group_by(x % 2 == 0): {grouped}")

    # Тестируем TypedList[str]
    print("\n=== Тестирование TypedList[str] ===")
    str_list = TypedList[str]()
    for word in ['apple', 'banana', 'cherry']:
        str_list.add(word)
    print(f"Список строк: {str_list}")

    # Тестируем TypedList[dict]
    print("\n=== Тестирование TypedList[dict] ===")
    dict_list = TypedList[dict]()
    for d in [{'id': 1}, {'id': 2}, {'id': 3}]:
        dict_list.add(d)
    print(f"Список словарей: {dict_list}")
