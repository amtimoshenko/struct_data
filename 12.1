    // Продолжение реализации CQRS на C++

#include <typeinfo>

class CommandBus {
private:
    std::unordered_map<std::string, std::shared_ptr<CommandHandler>> handlers;
public:
    template<typename T>
    void registerHandler(std::shared_ptr<CommandHandler> handler) {
        handlers[typeid(T).name()] = handler;
    }

    void send(std::shared_ptr<Command> command) {
        auto handler = handlers[typeid(*command.get()).name()];
        if (handler) {
            handler->handle(command);
        } else {
            std::cout << "No handler registered for command: "
                      << typeid(*command.get()).name() << std::endl;
        }
    }
};

class QueryBus {
private:
    std::unordered_map<std::string, std::shared_ptr<QueryHandler>> handlers;
public:
    template<typename T>
    void registerHandler(std::shared_ptr<QueryHandler> handler) {
        handlers[typeid(T).name()] = handler;
    }

    std::shared_ptr<void> send(std::shared_ptr<Query> query) {
        auto handler = handlers[typeid(*query.get()).name()];
        if (handler) {
            return handler->handle(query);
        } else {
            std::cout << "No handler registered for query: "
                      << typeid(*query.get()).name() << std::endl;
            return nullptr;
        }
    }
};

// Пример использования
int main() {
    // Инициализируем хранилища
    WriteStore writeStore;
    ReadStore readStore;

    // Создаём EventBus для синхронизации
    EventBus eventBus(readStore);

    // Создаём шины
    CommandBus commandBus;
    QueryBus queryBus;

    // Регистрируем обработчики команд
    commandBus.registerHandler<CreateProductCommand>(
        std::make_shared<CreateProductHandler>(writeStore, eventBus)
    );
    commandBus.registerHandler<UpdatePriceCommand>(
        std::make_shared<UpdatePriceHandler>(writeStore, eventBus)
    );

    // Регистрируем обработчики запросов
    queryBus.registerHandler<GetProductQuery>(
        std::make_shared<GetProductHandler>(readStore)
    );
    queryBus.registerHandler<GetProductsByCategoryQuery>(
        std::make_shared<GetProductsByCategoryHandler>(readStore)
    );
    queryBus.registerHandler<GetStatisticsQuery>(
        std::make_shared<GetStatisticsHandler>(readStore)
    );

    // Пример работы с системой
    std::cout << "=== Создание продукта ===" << std::endl;
    auto createCmd = std::make_shared<CreateProductCommand>("Laptop", 50000, "Electronics");
    commandBus.send(createCmd);

    // Получаем продукт по ID
    std::cout << "\n=== Получение продукта по ID ===" << std::endl;
    auto getQuery = std::make_shared<GetProductQuery>(1);
    auto result = queryBus.send(getQuery);
    if (result) {
        auto* product = static_cast<Product*>(result.get());
        std::cout << "Product: ID=" << product->id
                  << ", Name=" << product->name
                  << ", Price=" << product->price << std::endl;
    }

    // Обновляем цену
    std::cout << "\n=== Обновление цены ===" << std::endl;
    auto updateCmd = std::make_shared<UpdatePriceCommand>(1, 45000);
    commandBus.send(updateCmd);

    // Получаем статистику
    std::cout << "\n=== Получение статистики ===" << std::endl;
    auto statsQuery = std::make_shared<GetStatisticsQuery>();
    auto statsResult = queryBus.send(statsQuery);
    if (statsResult) {
        auto* stats = static_cast<ReadStore::Statistics*>(statsResult.get());
        std::cout << "Statistics: total=" << stats->total
                  << ", avgPrice=" << stats->avgPrice << std::endl;
        std::cout << "Categories: ";
        for (const auto& [cat, count] : stats->categories) {
            std::cout << cat << ":" << count << " ";
        }
        std::cout << std::endl;
    }

    return 0;
}
