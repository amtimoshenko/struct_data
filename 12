// WriteStore — хранилище для операций записи (источник истины)
class WriteStore {
    private List<Product> products = new ArrayList<>(); // Список всех продуктов
    private int nextId = 1; // Счётчик для генерации уникальных ID

    // Создаёт новый продукт и добавляет его в хранилище
    public void createProduct(String name, double price, String category) {
        Product product = new Product(nextId++, name, price, category);
        products.add(product);
    }

    // Обновляет цену продукта по ID. Возвращает true, если продукт найден и обновлён
    public boolean updatePrice(int productId, double newPrice) {
        for (Product product : products) {
            if (product.getId() == productId) {
                product.price = newPrice; // Обновляем цену (в реальности лучше использовать сеттер)
                return true;
            }
        }
        return false;
    }

    // Удаляет продукт по ID. Возвращает true, если продукт был найден и удалён
    public boolean deleteProduct(int productId) {
        Iterator<Product> iterator = products.iterator();
        while (iterator.hasNext()) {
            Product product = iterator.next();
            if (product.getId() == productId) {
                iterator.remove();
                return true;
            }
        }
        return false;
    }

    // Возвращает копию списка всех продуктов (чтобы избежать внешнего изменения хранилища)
    public List<Product> getAllProducts() {
        return new ArrayList<>(products);
    }
}

// ReadStore — оптимизированное хранилище для операций чтения
class ReadStore {
    private Map<Integer, ReadProduct> productsById = new HashMap<>(); // Быстрый доступ к продукту по ID
    private Statistics statistics = new Statistics(0, 0.0, new HashMap<>()); // Предрассчитанная статистика

    // Обрабатывает событие создания продукта: добавляет его в ReadStore и обновляет статистику
    public void handleProductCreated(Product product) {
        ReadProduct readProduct = new ReadProduct(product.getId(), product.getName(), product.getPrice());
        productsById.put(product.getId(), readProduct);

        // Обновляем статистику: увеличиваем общее количество, пересчитываем среднюю цену, добавляем категорию
        int total = statistics.getTotal() + 1;
        double avgPrice = (statistics.getAvgPrice() * (total - 1) + product.getPrice()) / total;
        Map<String, Integer> categories = new HashMap<>(statistics.getCategories());
        categories.put(product.getCategory(), categories.getOrDefault(product.getCategory(), 0) + 1);
        statistics = new Statistics(total, avgPrice, categories);
    }

