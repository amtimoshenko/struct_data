// Событие, возникающее при создании нового продукта
class ProductCreatedEvent implements Event {
    private Product product;

    public ProductCreatedEvent(Product product) {
        this.product = product; // Сохраняем продукт, который был создан
    }

    public Product getProduct() { return product; }
}

// Событие при обновлении цены продукта
class ProductPriceUpdatedEvent implements Event {
    private int productId;
    private double newPrice;

    public ProductPriceUpdatedEvent(int productId, double newPrice) {
        this.productId = productId; // ID продукта, чья цена изменилась
        this.newPrice = newPrice; // Новая цена
    }

    public int getProductId() { return productId; }
    public double getNewPrice() { return newPrice; }
}

// Событие при удалении продукта
class ProductDeletedEvent implements Event {
    private int productId;

    public ProductDeletedEvent(int productId) {
        this.productId = productId; // ID удалённого продукта
    }

    public int getProductId() { return productId; }
}

