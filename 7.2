#include <iostream>
#include <vector>
using namespace std;

// Узел дерева
struct TreeNode {
    int key;
    TreeNode* left;
    TreeNode* right;
    int height;

    TreeNode(int k) : key(k), left(nullptr), right(nullptr), height(1) {}
};

// Получение высоты узла
int getHeight(TreeNode* node) {
    if (!node) return 0;
    return node->height;
}

// Вычисление баланса узла (BF — balance factor)
int getBalance(TreeNode* node) {
    if (!node) return 0;
    return getHeight(node->left) - getHeight(node->right);
}

// Левый поворот (left_rotate)
TreeNode* leftRotate(TreeNode* z) {
    TreeNode* y = z->right;
    if (!y) return z; // Если правого потомка нет — ничего не делаем
    TreeNode* T2 = y->left;

    // Выполняем поворот
    y->left = z;
    z->right = T2;

    // Обновляем высоты
    z->height = max(getHeight(z->left), getHeight(z->right)) + 1;
    y->height = max(getHeight(y->left), getHeight(y->right)) + 1;

    return y; // Новый корень после поворота
}

// Правый поворот (right_rotate)
TreeNode* rightRotate(TreeNode* z) {
    TreeNode* y = z->left;
    if (!y) return z; // Если левого потомка нет — ничего не делаем
    TreeNode* T3 = y->right;

    // Выполняем поворот
    y->right = z;
    z->left = T3;

    // Обновляем высоты
    z->height = max(getHeight(z->left), getHeight(z->right)) + 1;
    y->height = max(getHeight(y->left), getHeight(y->right)) + 1;

    return y; // Новый корень после поворота
}

// Вставка узла с балансировкой (avl_insert)
TreeNode* avlInsert(TreeNode* root, int key) {
    // 1. Выполняем обычную вставку BST
    if (!root) return new TreeNode(key);

    if (key < root->key)
        root->left = avlInsert(root->left, key);
    else if (key > root->key)
        root->right = avlInsert(root->right, key);
    else
        return root; // Дубликаты не вставляем

    // 2. Обновляем высоту текущего узла
    root->height = 1 + max(getHeight(root->left), getHeight(root->right));

    // 3. Вычисляем баланс
    int balance = getBalance(root);

    // 4. Балансировка (4 случая)

    // LR-случай (баланс < -1 и ключ > правого потомка)
    if (balance < -1 && key > root->right->key) {
        root->right = leftRotate(root->right);
        return rightRotate(root);
    }

    // LL-случай (баланс > 1 и ключ < левого потомка)
    if (balance > 1 && key < root->left->key)
        return rightRotate(root);

    // RR-случай (баланс < -1 и ключ < правого потомка)
    if (balance < -1 && key < root->right->key)
        return leftRotate(root);

    // RL-случай (баланс > 1 и ключ > левого потомка)
    if (balance > 1 && key > root->left->key) {
        root->left = rightRotate(root->left);
        return leftRotate(root);
    }

    return root;
}

// Обход дерева в порядке inorder (возвращает вектор значений)
void inorderTraversal(TreeNode* root, vector<int>& res) {
    if (root) {
        inorderTraversal(root->left, res);
        res.push_back(root->key);
        inorderTraversal(root->right, res);
    }
}

// Основная программа
int main() {
    TreeNode* root = nullptr;

    // Вставляем ключи и выводим состояние дерева после каждой вставки
    root = avlInsert(root, 30);
    vector<int> res;
    inorderTraversal(root, res);
    cout << "После вставки 30: [";
    for (size_t i = 0; i < res.size(); ++i) {
        cout << res[i];
        if (i < res.size() - 1) cout << ", ";
    }
    cout << "]" << endl;
    res.clear();

    root = avlInsert(root, 10);
    inorderTraversal(root, res);
    cout << "После вставки 10: [";
    for (size_t i = 0; i < res.size(); ++i) {
        cout << res[i];
        if (i < res.size() - 1) cout << ", ";
    }
    cout << "]" << endl;
    res.clear();

    root = avlInsert(root, 20);
    inorderTraversal(root, res);
    cout << "После вставки 20 (с LR-поворотом): [";
    for (size_t i = 0; i < res.size(); ++i) {
        cout << res[i];
        if (i < res.size() - 1) cout << ", ";
    }
    cout << "]" << endl;
    res.clear();

    // Выводим итоговое дерево
    cout << "\nИтоговое дерево (inorder): [";
    inorderTraversal(root, res);
    for (size_t i = 0; i < res.size(); ++i) {
        cout << res[i];
        if (i < res.size() - 1) cout << ", ";
    }
    cout << "]" << endl;

    cout << "Корень: " << root->key << endl;
    cout << "Левый потомок корня: " << root->left->key << endl;
    cout << "Правый потомок корня: " << root->right->key << endl;

    return 0;
}
