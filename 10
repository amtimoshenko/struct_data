import time
import tracemalloc
from functools import reduce

# --- РЕАЛИЗАЦИЯ ТРЕХ ВЕРСИЙ РЕШЕТА ЭРАТОСФЕНА ---

def sieve_procedural(n):
    """
    Процедурная версия: использует явные циклы и изменяемый массив.
    Алгоритм: классический алгоритм решета Эратосфена.
    Особенности:
    - Создаёт булевый массив sieve размером n+1
    - Помечает составные числа как False
    - Использует вложенные циклы для отсеивания кратных
    - Эффективен по времени и памяти
    """
    if n < 2:
        return []
    sieve = [True] * (n + 1)  # Создаём массив-решето
    sieve[0] = sieve[1] = False  # 0 и 1 не являются простыми
    for i in range(2, int(n ** 0.5) + 1):  # Проверяем до √n
        if sieve[i]:  # Если число простое
            # Отмечаем все кратные числа как составные
            for j in range(i * i, n + 1, i):
                sieve[j] = False
    # Собираем простые числа из массива
    return [i for i, is_prime in enumerate(sieve) if is_prime]


def sieve_functional(n):
    """
    Функциональная версия: избегает изменяемого состояния, использует рекурсию и filter.
    Особенности:
    - Не использует присваивание переменных в традиционном смысле
    - Рекурсивно фильтрует кратные числа
    - Создаёт новые списки на каждом шаге (без изменения существующих)
    - Демонстрирует концепцию отсутствия побочных эффектов
    """
    if n < 2:
        return []

    def filter_multiples(primes, remaining):
        """
        Рекурсивная функция для фильтрации кратных чисел.
        Параметры:
        - primes: список уже найденных простых чисел
        - remaining: список кандидатов для проверки
        Возвращает: список простых чисел
        """
        if not remaining:  # Базовый случай рекурсии
            return primes
        p = remaining[0]  # Берём первое число как простое
        # Фильтруем все кратные p из оставшихся кандидатов
        new_remaining = list(filter(lambda x: x % p != 0, remaining))
        # Рекурсивный вызов с обновлёнными списками
        return filter_multiples(primes + [p], new_remaining)

    candidates = list(range(2, n + 1))  # Начальный список кандидатов
    return filter_multiples([], candidates)  # Запускаем рекурсию

def sieve_lazy():
    """
    Ленивый генератор: генерирует простые числа по требованию.
    Особенности:
    - Бесконечный генератор (не ограничен n)
    - Проверяет делимость на уже найденные простые числа
    - Экономит память: хранит только найденные простые
    - Подходит для генерации больших последовательностей
    """
    yield 2  # Первое простое число
    primes = [2]  # Список найденных простых чисел
    candidate = 3  # Начинаем проверку с 3

    while True:
        # Проверяем, делится ли кандидат на какие‑либо из найденных простых
        is_prime = all(candidate % p != 0 for p in primes if p * p <= candidate)
        if is_prime:
            primes.append(candidate)  # Добавляем в список простых
            yield candidate  # Выдаём следующее простое число
        candidate += 2  # Переходим к следующему нечётному числу

def get_primes_lazy(n):
    """
    Обёртка для ленивого генератора: получает простые числа до n.
    Параметры:
    - n: верхняя граница диапазона
    Возвращает: список простых чисел до n
    """
    result = []
    for prime in sieve_lazy():  # Используем ленивый генератор
        if prime > n:  # Прерываем, когда превысили n
            break
        result.append(prime)
    return result

