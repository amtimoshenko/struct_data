def test_correctness():
    """Проверяет корректность всех версий для n=20"""
    print("=== ПРОВЕРКА КОРРЕКТНОСТИ (n=20) ===")
    expected = [2, 3, 5, 7, 11, 13, 17, 19]
    versions = [
        ("Процедурная", sieve_procedural),
        ("Функциональная", sieve_functional),
        ("Ленивая", get_primes_lazy)
    ]
    for name, func in versions:
        result = func(20)
        status = "✓" if result == expected else "✗"
        print(f"{name}: {result} {status}")

def benchmark_sieve(func, n, func_name):
    """
    Измеряет время выполнения и потребление памяти функции.
    Параметры:
    - func: тестируемая функция
    - n: верхняя граница для поиска простых чисел
    - func_name: название функции для вывода
    Возвращает: результат выполнения функции
    """
    tracemalloc.start()  # Начинаем отслеживание памяти
    start_time = time.time()  # Фиксируем начальное время
    result = func(n)  # Выполняем функцию
    end_time = time.time()  # Фиксируем конечное время
    current, peak = tracemalloc.get_traced_memory()  # Получаем статистику по памяти
    tracemalloc.stop()  # Останавливаем отслеживание памяти

    # Выводим результаты
    print(f"{func_name}:")
    print(f"  Время выполнения: {(end_time - start_time) * 1000:.2f} мс")
    print(f"  Пиковое потребление памяти: {peak / 1024:.2f} КБ")
    print(f"  Количество найденных простых чисел: {len(result)}")
    print()
    return result

