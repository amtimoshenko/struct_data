#include <iostream>
using namespace std;

int main() {
    const int MAX_N = 1000;  // максимум элементов
    const int MAX_K = 10000; // максимум k

    int n, k;

    // Ввод данных
    cout << "Введите n (до " << MAX_N << "): ";
    cin >> n;
    cout << "Введите k (до " << MAX_K << "): ";
    cin >> k;

    int arr[MAX_N];  // основной массив
    int count[MAX_K + 1] = {0};  // массив для подсчёта
    int output[MAX_N];             // выходной массив

    // Заполняем массив
    cout << "Введите " << n << " чисел (от 0 до " << k << "):\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Шаг 1: подсчёт — сколько раз встречается каждое число
    for (int i = 0; i < n; i++) {
        count[arr[i]]++;
    }

    // Шаг 2: префиксные суммы — чтобы знать, куда ставить числа
    for (int i = 1; i <= k; i++) {
        count[i] += count[i - 1];
    }

    // Шаг 3: заполняем выходной массив (идём с конца для стабильности)
    for (int i = n - 1; i >= 0; i--) {
        int num = arr[i];
        int pos = count[num] - 1;
        output[pos] = num;
        count[num]--;
    }

    // Шаг 4: копируем результат обратно в исходный массив
    for (int i = 0; i < n; i++) {
        arr[i] = output[i];
    }

    // Выводим отсортированный массив
    cout << "Отсортированный массив:\n";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    // Вывод сравнения сложностей
    cout << "\nСРАВНЕНИЕ СЛОЖНОСТЕЙ:\n";
    cout << "====================\n";

    cout << "Counting Sort:\n";
    cout << "  Время: O(n + k) = O(" << n << " + " << k << ") = O(" << (n + k) << ")\n";
    cout << "  Память: O(k) = O(" << k << ")\n\n";

    cout << "Merge Sort:\n";
    cout << "  Время: O(n log n) ≈ O(" << n << " * 10) = O(" << n * 10 << ")\n";
    cout << "  Память: O(n) = O(" << n << ")\n";

    return 0;
}
