    std::vector<int> keys = {41, 38, 31, 12, 19, 8};
    RBTree rbTree;
    
    for (size_t i = 0; i < keys.size(); i++) {
        rbTree.insert(keys[i]);
        rbTree.print_state(i, keys);
    }
    
    std::cout << "\n========================================\n";
    std::cout << "СРАВНЕНИЕ КОЛИЧЕСТВА ВРАЩЕНИЙ\n";
    std::cout << "========================================\n";
    
    // Сравнение с AVL
    RBTreeWithCounter rbCounter;
    AVLTree avlTree;
    
    std::vector<int> testKeys = {41, 38, 31, 12, 19, 8};
    
    // Вставляем в RB дерево с подсчетом вращений
    for (int key : testKeys) {
        rbCounter.insert_with_count(key);
    }
    
    // Вставляем в AVL дерево с подсчетом вращений
    for (int key : testKeys) {
        avlTree.insert(key);
    }
    
    std::cout << "\nДля последовательности: ";
    for (int k : testKeys) std::cout << k << " ";
    std::cout << "\n";
    std::cout << "RB дерево (кол-во вращений): " << rbCounter.get_rotations() << "\n";
    std::cout << "AVL дерево (кол-во вращений): " << avlTree.get_rotations_count() << "\n";
    std::cout << "\nВывод: RB-дерево делает меньше вращений при вставке, чем AVL.\n";
    std::cout << "RB-дерево использует перекрашивания вместо вращений,\n";
    std::cout << "что делает его более эффективным для частых вставок.\n";
    
    return 0;
}
