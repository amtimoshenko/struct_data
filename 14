import csv
import pickle
from dataclasses import dataclass, field, is_dataclass, fields
from typing import Any, Optional, Type, Dict, List, Set
from datetime import date, datetime
from decimal import Decimal
from enum import Enum
from uuid import UUID

# Базовый класс для сериализаторов типов — определяет интерфейс
class TypeSerializer:
    def serialize(self, obj: Any) -> Any:
        raise NotImplementedError

    def deserialize(self, data: Any, cls: type) -> Any:
        raise NotImplementedError

# Сериализатор по умолчанию — просто передаёт объект без изменений
class DefaultTypeSerializer(TypeSerializer):
    def serialize(self, obj: Any) -> Any:
        return obj

    def deserialize(self, data: Any, cls: type) -> Any:
        return data

# Сериализатор для типа date — преобразует в строку ISO-формата и обратно
class DateSerializer(TypeSerializer):
    def serialize(self, obj: date) -> str:
        return obj.isoformat()  # Преобразуем дату в строку формата YYYY-MM-DD

    def deserialize(self, data: str, cls: type) -> date:
        return date.fromisoformat(data)  # Восстанавливаем дату из строки

# Сериализатор для datetime — аналогично date, но с временем
class DateTimeSerializer(TypeSerializer):
    def serialize(self, obj: datetime) -> str:
        return obj.isoformat()  # Преобразуем в строку с датой и временем

    def deserialize(self, data: str, cls: type) -> datetime:
        return datetime.fromisoformat(data)  # Восстанавливаем datetime из строки

# Сериализатор для Decimal — сохраняет точность десятичных чисел
class DecimalSerializer(TypeSerializer):
    def serialize(self, obj: Decimal) -> str:
        return str(obj)  # Преобразуем Decimal в строку, чтобы сохранить точность

    def deserialize(self, data: str, cls: type) -> Decimal:
        return Decimal(data)  # Восстанавливаем Decimal из строки

# Сериализатор для Enum — сохраняет только значение перечисления
class EnumSerializer(TypeSerializer):
    def serialize(self, obj: Enum) -> Any:
        return obj.value  # Сохраняем только значение элемента перечисления

    def deserialize(self, data: Any, cls: type) -> Enum:
        return cls(data)  # Создаём элемент перечисления из сохранённого значения

# Сериализатор для UUID — преобразует в строку и обратно
class UUIDSerializer(TypeSerializer):
    def serialize(self, obj: UUID) -> str:
        return str(obj)  # UUID в строковом представлении

    def deserialize(self, data: str, cls: type) -> UUID:
        return UUID(data)  # Восстанавливаем UUID из строки

@dataclass
class Employee:
